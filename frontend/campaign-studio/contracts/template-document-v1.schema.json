{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurevanta.es/schemas/campaign-studio/template-document-v1.schema.json",
  "title": "Aurevanta Campaign Studio TemplateDocument v1",
  "description": "Contrato canónico e inmutable de una plantilla editable. HTML y texto son derivados.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "settings", "variables", "blocks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "backgroundColor", "contentColor", "textColor", "mutedColor", "primaryColor", "accentColor", "fontFamily", "cornerRadius"],
      "properties": {
        "width": { "type": "integer", "minimum": 280, "maximum": 1600 },
        "backgroundColor": { "type": "string", "maxLength": 80 },
        "backgroundMode": { "enum": ["color", "image", "transparent"] },
        "backgroundImageUrl": { "type": "string", "maxLength": 20000 },
        "backgroundImageOpacity": { "type": "number", "minimum": 0, "maximum": 100 },
        "backgroundImagePosition": { "enum": ["left top", "center top", "right top", "left center", "center center", "right center", "left bottom", "center bottom", "right bottom"] },
        "backgroundImageSize": { "enum": ["cover", "contain", "auto"] },
        "backgroundImageRepeat": { "enum": ["no-repeat", "repeat"] },
        "contentColor": { "type": "string", "maxLength": 80 },
        "textColor": { "type": "string", "maxLength": 80 },
        "mutedColor": { "type": "string", "maxLength": 80 },
        "primaryColor": { "type": "string", "maxLength": 80 },
        "accentColor": { "type": "string", "maxLength": 80 },
        "fontFamily": { "type": "string", "maxLength": 500 },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 300 }
      }
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stylePreset", "intensity", "contentDensity", "colorMode", "compatibilityMode", "typographyStyle", "imageStyle"],
      "properties": {
        "stylePreset": { "type": "string", "minLength": 1, "maxLength": 120 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 100 },
        "contentDensity": { "enum": ["minimal", "balanced", "editorial"] },
        "colorMode": { "enum": ["light", "dark", "adaptive"] },
        "compatibilityMode": { "enum": ["compatible", "hybrid", "experimental"] },
        "typographyStyle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "imageStyle": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "builderStatus", "prospectorValidationRequired", "requiredRuntimeVariables", "senderIdentityConfigured", "privacyConfigured"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "builderStatus": { "enum": ["ready", "incomplete"] },
        "prospectorValidationRequired": { "const": true },
        "requiredRuntimeVariables": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "senderIdentityConfigured": { "type": "boolean" },
        "privacyConfigured": { "type": "boolean" }
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type", "required", "fallback", "source"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 120 },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "type": { "enum": ["text", "url", "date", "number"] },
          "required": { "type": "boolean" },
          "fallback": { "type": "string", "maxLength": 10000 },
          "source": { "enum": ["lead", "campaign", "sender", "system", "custom"] }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/block" }
    },
    "rawHtml": { "type": "string", "maxLength": 2000000 }
  },
  "$defs": {
    "scalar": { "oneOf": [{ "type": "string", "maxLength": 200000 }, { "type": "number" }, { "type": "boolean" }] },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "props"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "enum": ["brand", "hero", "heading", "artText", "text", "button", "image", "columns", "divider", "spacer", "footer"] },
        "props": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scalar" } },
        "moduleRef": {
          "type": "object", "additionalProperties": false, "required": ["id", "revision", "index"],
          "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "revision": { "type": "integer", "minimum": 1 }, "index": { "type": "integer", "minimum": 0 } }
        },
        "condition": {
          "type": "object", "additionalProperties": false, "required": ["field", "operator"],
          "properties": { "field": { "type": "string", "minLength": 1, "maxLength": 160 }, "operator": { "enum": ["equals", "not_equals", "contains", "exists"] }, "value": { "type": "string", "maxLength": 10000 } }
        },
        "mobile": {
          "type": "object", "additionalProperties": false,
          "properties": { "hidden": { "type": "boolean" }, "order": { "type": "integer", "minimum": 0, "maximum": 500 }, "widthPercent": { "type": "number", "minimum": 1, "maximum": 200 }, "fontScale": { "type": "number", "minimum": 25, "maximum": 300 }, "imageUrl": { "type": "string", "maxLength": 20000 }, "autoResponsive": { "type": "boolean" }, "freeX": { "type": "number", "minimum": -800, "maximum": 800 }, "freeY": { "type": "number", "minimum": -1200, "maximum": 1200 }, "freeZ": { "type": "number", "minimum": -50, "maximum": 100 }, "freeScale": { "type": "number", "minimum": 25, "maximum": 300 } }
        }
      }
    }
  }
}
