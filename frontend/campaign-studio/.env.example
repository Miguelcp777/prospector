# Única credencial para copy, asistente e imágenes IA. Solo servidor.
OPENAI_API_KEY=

# Bridge server-to-server de Prospector. No se exponen al navegador.
PROSPECTOR_API_URL=
PROSPECTOR_API_TOKEN=

# Transporte de pruebas y campañas, gestionado por Prospector.
EMAIL_PROVIDER_KEY=

# Sites inyecta DB y BUCKET desde .openai/hosting.json.
# En Supabase, configurar en Prospector mediante su gestor de secretos:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
