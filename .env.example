# ============================================================
# Prospector · variables de entorno
#
# Aquí solo va lo que necesita el FRONTEND, que es público por definición.
# Todo lo demás vive en los secretos de Supabase, no en un archivo:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set GOOGLE_PLACES_API_KEY=...
#   supabase secrets set WORKER_SECRETO=<cadena larga aleatoria>
#   supabase secrets set SAL_DEMO=<cadena larga aleatoria>
#   supabase secrets set ORIGENES_PERMITIDOS=https://prospector-demo.netlify.app
#
# SUPABASE_SERVICE_ROLE_KEY no aparece en ninguna lista: las Edge Functions
# ya la reciben del propio Supabase. Si te ves escribiéndola en algún sitio,
# párate a pensar dónde va a acabar.
# ============================================================

# ── Frontend ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://tpfjeumrvdbciktmaaii.supabase.co

# La clave del navegador. Solo puede hacer lo que permitan las políticas RLS.
VITE_SUPABASE_ANON_KEY=

# ── Demo de Netlify ─────────────────────────────────────────────────────────
# demo/index.html no lee variables de entorno: es un archivo estático sin
# build. La URL del proyecto se pega a mano en la constante SUPABASE_URL,
# arriba del <script>. No lleva ninguna clave.

# ── Envío de email (Fase 4 — no usar antes de revisar docs/compliance.md) ───
ESP_PROVIDER=
ESP_API_KEY=
SENDING_DOMAIN=
