# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://TU_REF.supabase.co

# Frontend. Solo puede hacer lo que permitan las políticas RLS.
SUPABASE_ANON_KEY=

# IMPORTANTE: solo en el servidor (worker). Se salta toda la RLS.
# Si acaba en el navegador, cualquiera lee los leads de todos los clientes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Worker de descubrimiento ────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ── Claves que NO van en este archivo ───────────────────────────────────────
# ANTHROPIC_API_KEY vive en los secretos de la Edge Function, no aquí:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# ── Envío de email (Fase 4 — no usar antes de revisar docs/compliance.md) ───
ESP_PROVIDER=
ESP_API_KEY=
SENDING_DOMAIN=

# ── App ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
